    {
      "parameters": {
        "jsCode": "// Pega o conteúdo codificado em base64 do GitHub e converte para texto UTF-8\nconst raw = Buffer.from($input.first().json.content, 'base64').toString('utf-8');\n\n// Converte o texto em um array JSON\nconst data = JSON.parse(raw);\n\n// Como o seu JSON é uma lista direta de itens, usamos o .map() direto na variável 'data'\nreturn data.map((a, i) => ({\n  json: {\n    id: i + 1,\n    titulo: a.titulo,\n    autor: a.autor,\n    ano: a.ano,\n    link_pdf: a.url_pdf\n  }\n}));"
      },
